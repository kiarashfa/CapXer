{
  "name": "capxer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && npm run check:emdash",
    "check:emdash": "node scripts/check-emdash.ts",
    "check:emdash:dist": "node scripts/check-emdash.ts --dist",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "ci": "npm run check && npm test && npm run build && npm run check:emdash:dist && npm run test:e2e"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/svelte": "9.1.1",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "astro": "7.4.2",
    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
