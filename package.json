{
  "name": "capxer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-csp.ts && node scripts/build-sw.ts",
    "preview": "astro preview",
    "brand": "node scripts/brand/brand.ts",
    "check": "astro check && npm run check:emdash && npm run check:data",
    "check:data": "node scripts/check-data.ts",
    "check:emdash": "node scripts/check-emdash.ts",
    "check:emdash:dist": "node scripts/check-emdash.ts --dist",
    "check:size": "node scripts/check-size.ts",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "ci": "npm run check && npm test && npm run build && npm run check:emdash:dist && npm run check:size && npm run test:e2e"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/svelte": "9.1.6",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/three": "0.187.0",
    "astro": "7.4.13",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "satteri": "0.10.5",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@threlte/core": "8.7.0",
    "three": "0.187.0"
  }
}
