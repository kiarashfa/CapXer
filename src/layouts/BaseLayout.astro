---
import '@fontsource-variable/figtree';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import ThemeToggle from '../components/site/ThemeToggle.svelte';
import ConsentBanner from '../components/site/ConsentBanner.svelte';
import { t } from '../i18n/en.ts';
import { url } from '../lib/url.ts';
import { THEME_KEY } from '../lib/theme.ts';
import { CONSENT_OPEN_EVENT } from '../lib/consent.ts';
import { REPO_URL, SITE_NAME } from '../config/site.ts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = t.site.description } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}: ${t.site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: url(), label: t.nav.home },
  { href: url('about'), label: t.nav.about },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#10151d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- Set the theme before first paint. Mirrors resolveTheme() in src/lib/theme.ts. -->
    <script is:inline define:vars={{ key: THEME_KEY }}>
      let stored = null;
      try { stored = localStorage.getItem(key); } catch {}
      const light = matchMedia('(prefers-color-scheme: light)').matches;
      document.documentElement.dataset.theme =
        stored === 'light' || stored === 'dark' ? stored : light ? 'light' : 'dark';
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-bg font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only rounded-full bg-ink px-4 py-2 text-bg no-underline focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50"
      >{t.nav.skip}</a
    >

    <header class="border-b border-line">
      <!-- Mobile/tablet: brand and theme button on one row, the menu on its own scrollable row. -->
      <div
        class="mx-auto flex max-w-page flex-wrap items-center gap-x-4 gap-y-2 px-4 pt-3 pb-2 desktop:px-8 desktop:py-3"
        style="padding-top: max(0.75rem, env(safe-area-inset-top));"
      >
        <a href={url()} class="flex min-h-11 items-center gap-2 text-lg font-extrabold tracking-tight text-ink no-underline">
          <svg aria-hidden="true" viewBox="0 0 32 32" class="size-6 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M4 11V4h7M21 4h7v7M28 21v7h-7M11 28H4v-7" />
            <circle cx="16" cy="16" r="2.6" fill="currentColor" stroke="none" />
          </svg>
          {SITE_NAME}
        </a>
        <nav aria-label={t.nav.label} class="order-last w-full overflow-x-auto pb-1 desktop:order-none desktop:ml-auto desktop:w-auto desktop:pb-0">
          <ul class="inline-flex gap-0.5 rounded-full bg-tint p-1 whitespace-nowrap">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={path === item.href ? 'page' : undefined}
                    class="inline-flex min-h-11 items-center rounded-full px-4 font-medium text-ink no-underline aria-[current=page]:bg-surface aria-[current=page]:font-semibold aria-[current=page]:text-accent aria-[current=page]:shadow-sm"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="ml-auto desktop:ml-0">
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-page flex-1 px-4 py-8 desktop:px-8 desktop:py-12">
      <slot />
    </main>

    <footer class="border-t border-line text-sm text-muted">
      <div
        class="mx-auto flex max-w-page flex-wrap items-center gap-x-5 gap-y-1 px-4 py-4 desktop:px-8"
        style="padding-bottom: max(1rem, env(safe-area-inset-bottom));"
      >
        <a href={url('privacy')}>{t.nav.privacy}</a>
        <button type="button" class="min-h-11 cursor-pointer text-accent underline underline-offset-3" data-open-consent>{t.consent.settings}</button>
        <a href={url('about')}>{t.nav.about}</a>
        <a href={REPO_URL}>{t.footer.source}</a>
        <span class="ml-auto font-semibold">{SITE_NAME}</span>
      </div>
    </footer>

    <ConsentBanner client:load />

    <script define:vars={{ eventName: CONSENT_OPEN_EVENT }} is:inline>
      document.querySelectorAll('[data-open-consent]').forEach((el) =>
        el.addEventListener('click', () => window.dispatchEvent(new Event(eventName))),
      );
    </script>
  </body>
</html>
