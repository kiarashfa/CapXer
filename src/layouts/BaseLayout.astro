---
import '@fontsource-variable/figtree';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/site-bar.css';
import ThemeToggle from '../components/site/ThemeToggle.svelte';
import ConsentBanner from '../components/site/ConsentBanner.svelte';
import { t } from '../i18n/en.ts';
import { url } from '../lib/url.ts';
import { THEME_KEY } from '../lib/theme.ts';
import { CONSENT_OPEN_EVENT } from '../lib/consent.ts';
import { REPO_URL, SITE_NAME } from '../config/site.ts';

interface Props {
  title?: string;
  description?: string;
  /** Accessible name of the page's dock (when the page fills the "dock" slot). */
  dockLabel?: string;
}

const { title, description = t.site.description, dockLabel = t.dock.label } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}: ${t.site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const hasDock = Astro.slots.has('dock');
const pages = [
  { href: url('viewfinder'), label: t.nav.viewfinder },
  { href: url('about'), label: t.nav.about },
];
const current = (href: string) => (path === href ? 'page' : undefined);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#10151d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- Set the theme before first paint. Mirrors resolveTheme() in src/lib/theme.ts. -->
    <script is:inline define:vars={{ key: THEME_KEY }}>
      let stored = null;
      try { stored = localStorage.getItem(key); } catch {}
      const light = matchMedia('(prefers-color-scheme: light)').matches;
      document.documentElement.dataset.theme =
        stored === 'light' || stored === 'dark' ? stored : light ? 'light' : 'dark';
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-bg font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only rounded-full bg-ink px-4 py-2 text-bg no-underline focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50"
      >{t.nav.skip}</a
    >

    <header class="site-bar" data-dock={hasDock ? 'closed' : undefined}>
      <div class="bar-box">
        <div class="bar-inner">
          <a href={url()} class="bar-brand">
            <svg aria-hidden="true" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M4 11V4h7M21 4h7v7M28 21v7h-7M11 28H4v-7" />
              <circle cx="16" cy="16" r="2.6" fill="currentColor" stroke="none" />
            </svg>
            {SITE_NAME}
          </a>
          <nav class="bar-pages" aria-label={t.nav.label}>
            <span class="divider" aria-hidden="true"></span>
            <ul>
              {pages.map((p) => <li><a href={p.href} aria-current={current(p.href)}>{p.label}</a></li>)}
            </ul>
          </nav>
          <div class="bar-toggles">
            <ThemeToggle client:load />
            <button type="button" class="menu-btn" data-menu-toggle aria-expanded="false" aria-controls="site-menu" aria-label={t.nav.menu}>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            </button>
          </div>
        </div>

        {
          hasDock && (
            <>
              <div class="bar-hang">
                <svg class="curve" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 0 C60 0 40 100 100 100 V0 Z" />
                </svg>
                <div class="hang-body">
                  <button type="button" class="dock-handle" aria-expanded="false" aria-controls="dock-tools" aria-label={t.dock.open}>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                  </button>
                </div>
                <svg class="curve" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 0 V100 C60 100 40 0 100 0 Z" />
                </svg>
              </div>
              <div class="dock-tools" id="dock-tools" role="group" aria-label={dockLabel}>
                <slot name="dock" />
                <span class="dock-sep" aria-hidden="true" />
                <button type="button" class="dock-icon" data-dock-pin aria-pressed="false" aria-label={t.dock.pin} title={t.dock.pin}>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l-1 6 3 3H7l3-3-1-6Z" /><path d="M12 12v9" /></svg>
                </button>
                <button type="button" class="dock-icon" data-dock-close aria-label={t.dock.close} title={t.dock.close}>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 15 6-6 6 6" /></svg>
                </button>
              </div>
            </>
          )
        }
      </div>
      <nav id="site-menu" class="card menu-sheet" aria-label={t.nav.menuLabel} hidden>
        {pages.map((p) => <a href={p.href} aria-current={current(p.href)}>{p.label}</a>)}
      </nav>
    </header>

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-page flex-1 px-4 py-8 desktop:px-8 desktop:py-12">
      <slot />
    </main>

    <footer class="border-t border-line text-sm text-muted">
      <div
        class="mx-auto flex max-w-page flex-wrap items-center gap-x-5 gap-y-1 px-4 py-4 desktop:px-8"
        style="padding-bottom: max(1rem, env(safe-area-inset-bottom));"
      >
        <a href={url('privacy')}>{t.nav.privacy}</a>
        <button type="button" class="min-h-11 cursor-pointer text-accent underline underline-offset-3" data-open-consent>{t.consent.settings}</button>
        <a href={url('about')}>{t.nav.about}</a>
        <a href={REPO_URL}>{t.footer.source}</a>
        <span class="ml-auto font-semibold">{SITE_NAME}</span>
      </div>
    </footer>

    <ConsentBanner client:load />

    <script define:vars={{ eventName: CONSENT_OPEN_EVENT }} is:inline>
      document.querySelectorAll('[data-open-consent]').forEach((el) =>
        el.addEventListener('click', () => window.dispatchEvent(new Event(eventName))),
      );
    </script>
    <script>
      import { initSiteBar } from '../lib/site-bar.ts';
      initSiteBar();
    </script>
  </body>
</html>
