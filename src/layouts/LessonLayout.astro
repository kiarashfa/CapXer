---
// One lesson (design E, owner 2026-11-20).
// - Citations are raised source numbers; a click or tap opens a popover with the
//   source and the exact place. Without JavaScript each is a plain link to its entry.
// - Desktop: "On this page" contents list on the left, following the reader.
// - Sources: one entry per source with every place cited, after the text, in a
//   collapsible block that starts open.
// - Text size buttons: dock on desktop, menu sheet on phone/tablet.
import BaseLayout from './BaseLayout.astro';
import TextSize from '../components/lesson/TextSize.astro';
import { t } from '../i18n/en.ts';
import { url } from '../lib/url.ts';
import { REPO_URL } from '../config/site.ts';
import { TEXT_SIZE_KEY, TEXT_STEPS } from '../lib/text-size.ts';
import { getReference } from '../references/index.ts';
import { formatReference } from '../content/cite/format.ts';
import { lessonUrl, longDate, type Lesson } from '../content/lessons.ts';
import '../styles/lesson.css';

interface Props {
  lesson: Lesson;
  minutes: number;
  headings: { depth: number; slug: string; text: string }[];
  /** Reference keys in order of first citation (from the citation plugin). */
  sources: string[];
  /** Every place cited, per source, same order (from the citation plugin). */
  citedAt: string[][];
  /** The lesson after this one; undefined while there is only one lesson. */
  next?: Lesson;
}
const { lesson, minutes, headings, sources, citedAt, next } = Astro.props;
const { title, summary, topic, updated } = lesson.data;
const sections = headings.filter((h) => h.depth === 2 && h.slug !== 'sources');
const list = sources.map((id, i) => {
  const ref = getReference(id);
  if (!ref) throw new Error(`Lesson ${lesson.id}: source ${id} missing from the reference library`);
  return { n: i + 1, id, f: formatReference(ref), at: citedAt[i] ?? [] };
});
---

<BaseLayout title={title} description={summary} dockLabel={t.dock.label}>
  <script is:inline slot="head" define:vars={{ key: TEXT_SIZE_KEY, steps: TEXT_STEPS }}>
    try {
      const z = Number(localStorage.getItem(key));
      if (steps.includes(z)) document.documentElement.style.setProperty('--text-zoom', String(z));
    } catch {}
  </script>
  <div slot="dock" class="dock-row">
    <span class="dock-label">{t.lessons.textSize}</span>
    <TextSize />
    {list.length > 0 && (
      <>
        <span class="dock-sep" aria-hidden="true"></span>
        <a class="dock-tool" href="#sources">
          {t.lessons.sourcesTitle}
        </a>
      </>
    )}
  </div>
  <div slot="menu" class="menu-text-size">
    <span>{t.lessons.textSize}</span>
    <TextSize />
  </div>

  <article class="lesson" data-lesson={lesson.id}>
    <header class="lesson-head">
      <p class="lesson-crumb">
        <a href={url('lessons')}>{t.lessons.title}</a>
        <span aria-hidden="true">/</span>
        {t.lessons.topics[topic]}
      </p>
      <h1 class="text-h1 leading-tight font-extrabold text-balance desktop:text-h1-desktop">
        {title}
      </h1>
      <p class="lesson-lead">{summary}</p>
      <p class="lesson-meta">
        <span>{t.lessons.minutes(minutes)}</span>
        <span>{t.lessons.sources(list.length)}</span>
        <span>
          {t.lessons.updated}{' '}
          <time datetime={updated.toISOString().slice(0, 10)}>{longDate(updated)}</time>
        </span>
      </p>
    </header>

    {sections.length > 0 && (
      <nav class="lesson-toc" aria-labelledby="toc-title">
        <p id="toc-title" class="lesson-toc-title">
          {t.dock.onThisPage}
        </p>
        <ol>
          {sections.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
          {list.length > 0 && (
            <li class="toc-sources">
              <a href="#sources">{t.lessons.sourcesTitle}</a>
            </li>
          )}
        </ol>
      </nav>
    )}

    <div class="lesson-body prose">
      <slot />

      {next && (
        <nav class="lesson-next" aria-label={t.lessons.next}>
          <a href={lessonUrl(next.id)}>
            <small>{t.lessons.next}</small>
            <b>{next.data.title}</b>
            <span>{next.data.summary}</span>
          </a>
          <a href={url('viewfinder')}>
            <small>{t.lessons.tool}</small>
            <b>{t.nav.viewfinder}</b>
            <span>{t.lessons.toolHint}</span>
          </a>
        </nav>
      )}

      <p class="lesson-report">
        {t.lessons.mistake} <a href={`${REPO_URL}/issues`}>{t.lessons.report}</a>.
      </p>

      {list.length > 0 && (
        <details class="lesson-sources" open>
          <summary>
            <h2 id="sources">{t.lessons.sourcesTitle}</h2>
            <span class="lesson-sources-count">{list.length}</span>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <p class="lesson-sources-hint">{t.lessons.sourcesHint}</p>
          <ol>
            {list.map(({ n, id, f, at }) => (
              <li id={`source-${n}`} data-ref={id}>
                <span class="src-n">{n}</span>
                <div class="src-body">
                  <p class="src-text">
                    {f.authors && <>{f.authors}, </>}
                    {f.italic ? <cite>{f.title}</cite> : <>"{f.title}"</>}
                    {f.details && <>, {f.details}</>}.
                  </p>
                  <p class="src-links">
                    {f.url && (
                      <a href={f.url} rel="noopener">
                        {t.lessons.openSource}
                      </a>
                    )}
                    {f.accessed && <span>{f.accessed}</span>}
                  </p>
                  <p class="src-at">
                    {t.lessons.citedAt}: <b>{at.join(', ')}</b>
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </details>
      )}
    </div>
  </article>

  <div
    class="cite-pop card"
    data-cited-at={t.lessons.citedHere}
    role="dialog"
    aria-modal="false"
    aria-labelledby="cite-pop-label"
    hidden
  >
    <div class="cite-pop-head">
      <span id="cite-pop-label" class="cite-pop-label">
        {t.lessons.source}
      </span>
      <span class="cite-pop-title"></span>
      <button type="button" class="cite-pop-x" aria-label={t.lessons.close} title={t.lessons.close}>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <div class="cite-pop-body"></div>
    <p class="cite-pop-at"></p>
    <p class="cite-pop-links">
      <a class="cite-pop-all" href="#sources">
        {t.lessons.allSources}
      </a>
    </p>
  </div>
</BaseLayout>

<script>
  import { initCitations, initLessonToc } from '../lib/citations.ts';
  import { initTextSize } from '../lib/text-size.ts';
  initCitations();
  initLessonToc();
  initTextSize();
</script>
