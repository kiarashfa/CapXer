---
// Decorative hero illustration in the viewfinder style: a line-drawn 16:9
// scene on grid paper, seen through 2.39:1 frame lines with a hatched mask
// and rule-of-thirds guides. Geometry: 2.39:1 inside 16:9 uses
// (16/9) / 2.39 = 74.38% of the height, so each mask band is 12.81%.
const MASK = 12.81;
const FRAME = 100 - 2 * MASK;
const thirds = [MASK + FRAME / 3, MASK + (2 * FRAME) / 3];
---

<div aria-hidden="true">
  <div class="grid-paper relative aspect-video overflow-hidden rounded-frame text-ink" style="box-shadow: 0 0 0 1px var(--strong)">
    <svg viewBox="0 0 358 201" preserveAspectRatio="none" class="absolute inset-0 size-full" fill="none" stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke">
      <circle cx="268" cy="72" r="14" vector-effect="non-scaling-stroke"></circle>
      <path d="M0 138 Q64 101 128 128 T248 117 T358 110" vector-effect="non-scaling-stroke"></path>
      <path d="M0 162 Q82 138 174 156 T358 147" vector-effect="non-scaling-stroke"></path>
      <path d="M233 158 v-31 a5.5 5.5 0 0 1 11 0 v31Z M238.5 117 a5.5 5.5 0 1 1 0.01 0Z" vector-effect="non-scaling-stroke"></path>
    </svg>
    <div class="hatch absolute inset-x-0 top-0" style={`height: ${MASK}%`}></div>
    <div class="hatch absolute inset-x-0 bottom-0" style={`height: ${MASK}%`}></div>
    <div class="absolute inset-x-0" style={`top: ${MASK}%; bottom: ${MASK}%; box-shadow: inset 0 0 0 2px var(--accent)`}></div>
    <div class="absolute border-l border-accent opacity-55" style={`left: 33.333%; top: ${MASK}%; bottom: ${MASK}%`}></div>
    <div class="absolute border-l border-accent opacity-55" style={`left: 66.667%; top: ${MASK}%; bottom: ${MASK}%`}></div>
    {thirds.map((y) => <div class="absolute inset-x-0 border-t border-accent opacity-55" style={`top: ${y}%`} />)}
    <span class="absolute top-[3%] left-3 rounded-full bg-surface px-2 font-mono text-label text-ink">2.39 : 1</span>
  </div>
  <div class="relative mt-2 h-6 border-x border-strong">
    <div class="absolute inset-x-0 top-[11px] border-t border-strong"></div>
    <span class="absolute top-0.5 left-1/2 -translate-x-1/2 bg-bg px-2 font-mono text-label text-muted">16 : 9 recorded area</span>
  </div>
</div>
