---
// One card in a DocPage grid. `wide` spans both desktop columns; `tone="note"`
// makes it a tinted note panel instead of a card.
interface Props {
  id: string;
  title: string;
  wide?: boolean;
  tone?: 'card' | 'note';
}
const { id, title, wide = false, tone = 'card' } = Astro.props;
---

<section
  aria-labelledby={id}
  class:list={['space-y-3 p-6 leading-relaxed', tone === 'note' ? 'note' : 'card', wide && 'desktop:col-span-2']}
>
  <h2 id={id} class="text-lg font-bold">{title}</h2>
  <slot />
</section>
