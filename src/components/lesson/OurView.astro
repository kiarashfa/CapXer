---
// Opinion or advice that no source states. Exempt from the citation rule, and
// labelled as ours so it is never mistaken for a sourced fact.
import { t } from '../../i18n/en.ts';
---

<aside class="lesson-box lesson-ourview" aria-label={t.lessons.ourView}>
  <div class="lesson-tag">
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-8l-4 3v-3H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"></path>
    </svg>
    {t.lessons.ourView}
    <span class="lesson-tag-hint">{t.lessons.ourViewHint}</span>
  </div>
  <slot />
</aside>
