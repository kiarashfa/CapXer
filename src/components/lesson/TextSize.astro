---
// Smaller / reset / larger text buttons for a lesson. Used in the desktop dock and
// in the phone/tablet menu sheet; src/lib/text-size.ts keeps them in step.
import { t } from '../../i18n/en.ts';
---

<span class="text-size" role="group" aria-label={t.lessons.textSize} data-text-size-group>
  <button type="button" data-text-size="down" aria-label={t.lessons.smaller} title={t.lessons.smaller}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18 8 6l5 12M4.6 14h6.8"></path><path d="M15 12h6"></path></svg>
  </button>
  <button type="button" data-text-size="reset" aria-label={t.lessons.resetSize} title={t.lessons.resetSize}>100%</button>
  <button type="button" data-text-size="up" aria-label={t.lessons.larger} title={t.lessons.larger}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18 8 6l5 12M4.6 14h6.8"></path><path d="M15 12h6M18 9v6"></path></svg>
  </button>
</span>
