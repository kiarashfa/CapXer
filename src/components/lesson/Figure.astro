---
// A numbered figure: title bar, then the drawing, then a caption paragraph
// (the caption is ordinary Markdown, so the citation rule applies to it).
// Numbers come from a CSS counter in document order.
import { t } from '../../i18n/en.ts';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<figure class="lesson-figure">
  <figcaption class="lesson-figure-title">
    <span class="lesson-figure-n">{t.lessons.figure}</span> {title}
  </figcaption>
  <slot />
</figure>
