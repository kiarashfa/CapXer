---
// Your profile: name, picture, save file and cloud save. Also where Dropbox
// sends the user back after connecting (its redirect URI is this page).
import BaseLayout from '../layouts/BaseLayout.astro';
import Profile from '../components/user/Profile.svelte';
import { t } from '../i18n/en.ts';
---

<BaseLayout title={t.user.title} description={t.user.description}>
  <article class="space-y-8 desktop:space-y-10">
    <header class="border-b border-line pb-6">
      <h1 class="text-h1 leading-tight font-extrabold desktop:text-h1-desktop">{t.user.title}</h1>
    </header>
    <Profile client:only="svelte" />
  </article>
</BaseLayout>
