---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocPage from '../components/layout/DocPage.astro';
import DocSection from '../components/layout/DocSection.astro';
import { REPO_URL } from '../config/site.ts';
import { t } from '../i18n/en.ts';
import { devices, sensors } from '../data/index.ts';
import { getReference, type Reference } from '../references/index.ts';
import { SAFE_AREAS } from '../setup/presets.ts';
import { BT709 } from '../analysis/levels.ts';

// Every source the camera and device database, the viewfinder's guides and the exposure aids cite, generated from the data so it never drifts.
const citedIds = new Set([
  ...sensors.flatMap((s) => [s.pitch?.citation.ref, ...s.formats.map((f) => f.citation.ref)]),
  ...devices.flatMap((d) => d.cameras.map((c) => c.citation.ref)),
  SAFE_AREAS.citation.ref,
  BT709.ref,
]);
const dataSources = [...citedIds]
  .map((id) => getReference(id!))
  .filter((r): r is Reference => !!r)
  .sort((a, b) => (a.publisher ?? '').localeCompare(b.publisher ?? '') || a.title.localeCompare(b.title));

// Keep in sync with THIRD_PARTY.md in the repo root.
const software = [
  { name: 'Astro', use: 'Site framework (build time)', licence: 'MIT', href: 'https://astro.build' },
  { name: 'Svelte', use: 'Interactive components', licence: 'MIT', href: 'https://svelte.dev' },
  { name: 'Tailwind CSS', use: 'Styling (build time)', licence: 'MIT', href: 'https://tailwindcss.com' },
  { name: 'Figtree', use: 'Typeface', licence: 'SIL Open Font', href: 'https://github.com/erikdkennedy/figtree' },
  { name: 'JetBrains Mono', use: 'Typeface for numbers', licence: 'SIL Open Font', href: 'https://github.com/JetBrains/JetBrainsMono' },
];
---

<BaseLayout title="About" description="What CapXer is, who made it, and the software and data it builds on." dockLabel={t.dock.onThisPage}>
  <div slot="dock" class="dock-row">
    <span class="dock-label">{t.dock.onThisPage}</span>
    <a class="dock-tool" href="#licence">Licence</a>
    <a class="dock-tool" href="#credits">Credits</a>
    <a class="dock-tool" href="#exposure-aids">Exposure aids</a>
    <a class="dock-tool" href="#data-sources">Data sources</a>
  </div>
  <DocPage
    title="About CapXer"
    lead="A director's viewfinder is a small handheld tool for previewing a shot without the camera. CapXer brings that idea to the browser, adds your phone or webcam as a live view, and explains the ideas behind it in short, cited lessons."
  >
    <DocSection id="licence" title="Licence">
      <p>
        CapXer is free to use. Its source code is public under a source-available licence, which is not an open source
        licence. Read the terms in the <a href={`${REPO_URL}/blob/main/LICENSE`}>LICENSE file</a>.
      </p>
      <p class="text-muted">
        The full list of third-party software and data is in the{' '}
        <a href={`${REPO_URL}/blob/main/THIRD_PARTY.md`}>THIRD_PARTY.md file</a>.
      </p>
    </DocSection>

    <DocSection id="credits" title="Credits">
      <p>CapXer is built with the following software. Thank you to everyone who maintains it.</p>
      <ul class="divide-y divide-line border-y border-line">
        {
          software.map((s) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 py-2.5">
              <a href={s.href}>{s.name}</a>
              <span class="text-sm text-muted">
                {s.use}, {s.licence} licence
              </span>
            </li>
          ))
        }
      </ul>
    </DocSection>

    <DocSection id="exposure-aids" title="Exposure aids" wide>
      <p>
        The histogram, zebras, false colour and focus peaking on the live camera are measured on the video your browser
        receives. That picture has already been through your phone's or webcam's own automatic exposure and processing.
        It is not RAW, and not the log signal of a cinema camera, so treat the aids as a guide to light and contrast,
        not as a light meter.
      </p>
      <p>
        Brightness is measured as luma from the BT.709 video standard. There is no industry standard for false colour:
        every camera maker uses its own table. CapXer places its bands around an 18% grey card using the BT.709 video
        curve. Phones shape their picture with their own curve, so the stop labels are approximate.
      </p>
    </DocSection>

    <DocSection id="data-sources" title="Camera data sources" wide>
      <p>
        Every sensor size, phone and webcam angle of view, guide and exposure-aid level in CapXer comes from one of these sources: the maker's own specifications or a
        published standard. Each value records exactly where in the source it was found.
      </p>
      <ul class="grid gap-x-8 border-t border-line desktop:grid-cols-2">
        {
          dataSources.map((r) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line py-2.5">
              {r.URL ? <a href={r.URL}>{r.title}</a> : <span>{r.title}</span>}
              <span class="font-mono text-label text-muted">{r.number ? `${r.publisher}, ${r.number}` : r.publisher}</span>
            </li>
          ))
        }
      </ul>
    </DocSection>
  </DocPage>
</BaseLayout>
