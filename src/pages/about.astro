---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocPage from '../components/layout/DocPage.astro';
import DocSection from '../components/layout/DocSection.astro';
import { t } from '../i18n/en.ts';
import { devices, sensors } from '../data/index.ts';
import { getReference, type Reference } from '../references/index.ts';
import { SAFE_AREAS } from '../setup/presets.ts';
import { BT709 } from '../analysis/levels.ts';
import { C2_SOURCE, CMF_SOURCE, DOF_SOURCE, EV_SOURCE, METER_K_SOURCE, PRIMARIES_SOURCE, SHUTTER_ANGLE_SOURCE } from '../optics/index.ts';
import { CREDITS } from '../content/credits.ts';
import { longDate } from '../content/lessons.ts';
import { REPO_URL, VERSION } from '../config/site.ts';
import { url } from '../lib/url.ts';

// Every source the camera and device database, the viewfinder's guides and the exposure aids cite, generated from the data so it never drifts.
const citedIds = new Set([
  ...sensors.flatMap((s) => [s.pitch?.citation.ref, ...s.formats.map((f) => f.citation.ref)]),
  ...devices.flatMap((d) => d.cameras.map((c) => c.citation.ref)),
  SAFE_AREAS.citation.ref,
  BT709.ref,
]);
const bySource = (ids: Iterable<string | undefined>) =>
  [...new Set(ids)]
    .map((id) => getReference(id!))
    .filter((r): r is Reference => !!r)
    .sort((a, b) => (a.publisher ?? a.title).localeCompare(b.publisher ?? b.title) || a.title.localeCompare(b.title));
const dataSources = bySource(citedIds);
// The lab's maths (src/optics: exposure, depth of field, colour of light).
const labSources = bySource([EV_SOURCE, METER_K_SOURCE, SHUTTER_ANGLE_SOURCE, DOF_SOURCE, CMF_SOURCE, C2_SOURCE, PRIMARIES_SOURCE].map((c) => c.ref));
const sourceNote = (r: Reference) => (r.number ? `${r.publisher}, ${r.number}` : (r.publisher ?? r['container-title'] ?? ''));

// Shared with THIRD_PARTY.md through tests/unit/credits.test.ts.
const software = CREDITS.filter((c) => c.about);
const built = longDate(new Date());
---

<BaseLayout title="About" description="What CapXer is, who made it, and the software and data it builds on." dockLabel={t.dock.onThisPage}>
  <div slot="dock" class="dock-row">
    <span class="dock-label">{t.dock.onThisPage}</span>
    <a class="dock-tool" href="#licence">Licence</a>
    <a class="dock-tool" href="#privacy">Privacy</a>
    <a class="dock-tool" href="#credits">Credits</a>
    <a class="dock-tool" href="#install">Install</a>
    <a class="dock-tool" href="#exposure-aids">Aids</a>
    <a class="dock-tool" href="#lab">Lab</a>
    <a class="dock-tool" href="#data-sources">Sources</a>
    <a class="dock-tool" href="#accessibility">Accessibility</a>
  </div>
  <DocPage
    title="About CapXer"
    lead="A director's viewfinder is a small handheld tool for previewing a shot without the camera. CapXer brings that idea to the browser, adds your phone or webcam as a live view and a 3D studio to practise exposure, and explains the ideas behind it in short, cited lessons."
  >
    <DocSection id="licence" title="Licence">
      <p>
        CapXer is free to use. Its source code is public under a source-available licence, which is not an open source
        licence. Read the terms in the <a href={`${REPO_URL}/blob/main/LICENSE`}>LICENSE file</a>.
      </p>
      <p class="text-muted">
        The full list of third-party software and data is in the{' '}
        <a href={`${REPO_URL}/blob/main/THIRD_PARTY.md`}>THIRD_PARTY.md file</a>.
      </p>
    </DocSection>

    <DocSection id="privacy" title="Privacy">
      <p>
        CapXer has no server, no database and no accounts. Your camera feed, photos, setups, lab settings, name and picture stay on
        your device unless you share a link, download your save file or turn on cloud save. If you allow
        analytics, Google Analytics counts visits to the site and sets cookies, but it never sees your camera, your
        setups, your name or your picture. If you decline, it is not loaded at all. You can change your answer at any
        time:{' '}
        <button type="button" class="cursor-pointer text-accent underline underline-offset-3" data-open-consent>
          {t.consent.settings}
        </button>
      </p>
      <p>
        Cloud save is off unless you turn it on in <a href={url('user')}>your profile</a>. Your browser then keeps a
        copy of your save file in your own Google Drive or Dropbox, in a private folder only CapXer can use, and nothing
        passes through any server of ours. CapXer uses that access only to read and write this one file. You can
        disconnect at any time, which also ends the access, and signing out removes everything from the browser. Data
        from Google is handled under the{' '}
        <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>,
        including its Limited Use requirements.
      </p>
    </DocSection>

    <DocSection id="credits" title="Credits">
      <p>CapXer is built with the following software. Thank you to everyone who maintains it.</p>
      <ul class="divide-y divide-line border-y border-line">
        {
          software.map((s) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 py-2.5">
              <a href={s.href}>{s.name}</a>
              <span class="text-sm text-muted">
                {s.use}, {s.licence} licence
              </span>
            </li>
          ))
        }
      </ul>
    </DocSection>

    <DocSection id="install" title="Install the app">
      <p>
        CapXer works as an app on your phone or computer. Installed, it opens straight into the viewfinder and works without a connection, live camera included. The lab needs a connection and a computer.
      </p>
      <ul class="list-disc space-y-1 pl-5">
        <li>Android, and Chrome or Edge on a computer: choose {t.pwa.install} in CapXer's menu or top bar, or your browser's own install option.</li>
        <li>iPhone and iPad: open CapXer in Safari, tap Share, then Add to Home Screen.</li>
      </ul>
      <p class="text-muted">New versions download by themselves. When one is ready, a note offers to reload.</p>
    </DocSection>

    <DocSection id="exposure-aids" title="Exposure aids">
      <p>
        The histogram, zebras, false colour and focus peaking on the live camera are measured on the video your browser
        receives. That picture has already been through your phone's or webcam's own automatic exposure and processing.
        It is not RAW, and not the log signal of a cinema camera, so treat the aids as a guide to light and contrast,
        not as a light meter.
      </p>
      <p>
        Brightness is measured as luma from the BT.709 video standard. There is no industry standard for false colour:
        every camera maker uses its own table. CapXer places its bands around an 18% grey card using the BT.709 video
        curve. Phones shape their picture with their own curve, so the stop labels are approximate.
      </p>
    </DocSection>

    <DocSection id="lab" title="How the lab works">
      <p>
        The lab draws a small studio in 3D and builds each picture from many renders, the way a lens and a shutter gather
        light: the camera moves across the lens opening for depth of field, the scene moves during the exposure for motion
        blur, and each light spreads over its size for soft shadows. It needs a computer with WebGL 2.
      </p>
      <p>
        Lights are set in physical units, so the meter reads the scene like a reflected-light meter with the common
        calibration constant of 12.5, and a correct exposure puts the metered brightness at 18% grey. Depth of field uses
        a circle of confusion of the frame diagonal divided by 1500. Each light's colour is that of a glowing body at its
        colour temperature. The grain is CapXer's own simplified model of sensor noise, not a specific camera, and the lens
        lets all its light through, so a T-stop equals the f-number.
      </p>
      <p class="text-muted">The lab's numbers come from these sources:</p>
      <ul class="border-t border-line" data-testid="lab-sources">
        {
          labSources.map((r) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line py-2.5">
              {r.URL ? <a href={r.URL}>{r.title}</a> : <span>{r.title}</span>}
              <span class="font-mono text-label text-muted">{sourceNote(r)}</span>
            </li>
          ))
        }
      </ul>
    </DocSection>

    <DocSection id="data-sources" title="Camera data sources" wide>
      <p>
        Every sensor size, phone and webcam angle of view, guide and exposure-aid level in CapXer comes from one of these sources: the maker's own specifications or a
        published standard. Each value records exactly where in the source it was found.
      </p>
      <ul class="grid gap-x-8 border-t border-line desktop:grid-cols-2">
        {
          dataSources.map((r) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line py-2.5">
              {r.URL ? <a href={r.URL}>{r.title}</a> : <span>{r.title}</span>}
              <span class="font-mono text-label text-muted">{sourceNote(r)}</span>
            </li>
          ))
        }
      </ul>
    </DocSection>

    <DocSection id="accessibility" title="Accessibility">
      <p>
        CapXer aims to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at level AA, in both the light and the
        dark theme. Every page works with a keyboard, and every page is checked automatically for accessibility problems
        before each release.
      </p>
      <p>
        Some tools are visual by nature: the framing in the viewfinder, the exposure aids on the live camera and the picture in
        the lab describe a picture, so they help most if you can see the screen. Their settings and readouts are available as
        text, and in the lab the lights and the camera move on the studio plan with the arrow keys.
      </p>
      <p class="text-muted">
        Found something that is hard to use? Please{' '}
        <a href={`${REPO_URL}/issues`}>open an issue on GitHub</a>.
      </p>
    </DocSection>
  </DocPage>
  <p class="mt-8 text-sm text-muted" data-testid="version">{t.about.version(VERSION, built)}</p>
</BaseLayout>
