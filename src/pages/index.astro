---
import BaseLayout from '../layouts/BaseLayout.astro';
import FramePreview from '../components/layout/FramePreview.astro';
import { url } from '../lib/url.ts';

const pillars = [
  {
    title: 'Viewfinder',
    href: url('viewfinder'),
    body: 'Choose a sensor or film format, an aspect ratio and a focal length, and see the exact frame with frame lines and composition guides.',
  },
  {
    title: 'Live camera',
    href: url('viewfinder'),
    body: 'Point your phone or webcam at a real location and check framing with exposure aids such as a histogram, zebras and focus peaking.',
  },
  {
    title: 'Lab',
    href: url('lab'),
    body: 'Light a small studio and take the shot. Aperture, shutter, ISO and white balance change the picture like a real camera, with a meter and a top view of the set. Needs a computer.',
  },
  {
    title: 'Lessons',
    href: url('lessons'),
    body: 'Short, cited lessons on the ideas behind the tools: aspect ratios, focal length and composition.',
  },
];
---

<BaseLayout>
  <section class="grid items-center gap-8 desktop:grid-cols-2 desktop:gap-16">
    <div>
      <h1 class="text-h1 leading-tight font-extrabold text-balance desktop:text-h1-desktop">A director's viewfinder in your browser</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Preview a shot before the camera arrives, and practise exposure in a 3D studio. CapXer is free, has no ads and no
        accounts, and your camera feed never leaves your device.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a class="btn btn-primary" href={url('viewfinder')}>Open the viewfinder</a>
        <p class="inline-flex max-w-full items-center gap-3 rounded-3xl bg-tint py-2 pr-4 pl-2 text-sm">
          <span class="flex-none rounded-full bg-surface px-2 py-0.5 font-mono text-label tracking-wide text-accent uppercase">Status</span>
          <span class="min-w-0">New: the{' '}<a href={url('lab')}>Lab</a>, a 3D studio where aperture, shutter and ISO change the picture like a real camera.</span>
        </p>
      </div>
    </div>
    <FramePreview />
  </section>

  <section aria-labelledby="pillars" class="mt-12 desktop:mt-16">
    <h2 id="pillars" class="sr-only">What CapXer does</h2>
    <ul class="grid gap-4 desktop:grid-cols-2 desktop:gap-6">
      {
        pillars.map((p) => (
          <li class="card p-6">
            <h3 class="text-lg font-bold"><a href={p.href}>{p.title}</a></h3>
            <p class="mt-2 leading-relaxed text-muted">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="mt-12 text-center text-muted">
    Curious how your data is handled? Read the <a href={`${url('about')}#privacy`}>privacy section</a>.
  </p>
</BaseLayout>
