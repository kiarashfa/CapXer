---
import { render } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import Figure from '../../components/lesson/Figure.astro';
import RatioFrames from '../../components/lesson/RatioFrames.astro';
import FovWedges from '../../components/lesson/FovWedges.astro';
import GuideFrame from '../../components/lesson/GuideFrame.astro';
import Try from '../../components/lesson/Try.astro';
import TryLink from '../../components/lesson/TryLink.astro';
import OurView from '../../components/lesson/OurView.astro';
import { getLessons, readingMinutes, type Lesson } from '../../content/lessons.ts';

export async function getStaticPaths() {
  const all = await getLessons();
  // "Next lesson" follows the Lessons page order and wraps around; none while there is one lesson.
  return all.map((lesson, i) => ({
    params: { slug: lesson.id },
    props: { lesson, next: all.length > 1 ? all[(i + 1) % all.length] : undefined },
  }));
}

const { lesson, next } = Astro.props as { lesson: Lesson; next?: Lesson };
const { Content, headings, remarkPluginFrontmatter } = await render(lesson);
// Components every lesson can use without importing them.
const components = { Figure, RatioFrames, FovWedges, GuideFrame, Try, TryLink, OurView };
---

<LessonLayout lesson={lesson} minutes={readingMinutes(lesson.body ?? '')} headings={headings}
  sources={remarkPluginFrontmatter.sources ?? []}
  citedAt={remarkPluginFrontmatter.citedAt ?? []}
  next={next}
>
  <Content components={components} />
</LessonLayout>
